{
  "name": "@helmsmith/flow-spec",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./definition": "./src/definition.ts",
    "./run": "./src/run.ts",
    "./tenancy": "./src/tenancy.ts",
    "./schema": "./schema/flow-spec.schema.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "ts-json-schema-generator --path src/schema-roots.ts --type FlowSpecSchemaRoots --tsconfig tsconfig.json --out schema/flow-spec.schema.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "ts-json-schema-generator": "^2.9.0"
  },
  "description": "The Helmsmith flow wire contract: flow/step/edge types, catalog validator (join-hazard analysis included), expression evaluator, JSON-Schema subset, conformance fixtures, and the generated schema artifact. Browser-safe, zero runtime dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JefeLabs/helmsmith.git",
    "directory": "platform/harness/flow-spec"
  },
  "keywords": [
    "workflow",
    "flow",
    "agent",
    "orchestration",
    "dag",
    "validator",
    "wire-contract",
    "json-schema"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "SPEC.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./definition": {
        "types": "./dist/definition.d.ts",
        "default": "./dist/definition.js"
      },
      "./run": {
        "types": "./dist/run.d.ts",
        "default": "./dist/run.js"
      },
      "./tenancy": {
        "types": "./dist/tenancy.d.ts",
        "default": "./dist/tenancy.js"
      },
      "./schema": "./schema/flow-spec.schema.json"
    }
  }
}
