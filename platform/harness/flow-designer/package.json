{
  "name": "@helmsmith/flow-designer",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build && npm run build:lib",
    "build:lib": "rm -rf dist-lib && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@helmsmith/flow-spec": "workspace:*"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "description": "Visual flow designer for @helmsmith/flow-spec catalogs — drag-and-drop canvas with the exact validator and expression evaluator the runtime uses, live on every edit. Run with npx against any harness or controlplane serving the /v1/catalog wire shape.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JefeLabs/helmsmith.git",
    "directory": "platform/harness/flow-designer"
  },
  "keywords": [
    "workflow",
    "flow",
    "designer",
    "editor",
    "react-flow",
    "agent",
    "orchestration"
  ],
  "bin": {
    "flow-designer": "bin/flow-designer.mjs"
  },
  "files": [
    "dist",
    "dist-lib",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist-lib/flow-designer.js",
  "types": "./dist-lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "default": "./dist-lib/flow-designer.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
