{
  "name": "@helmsmith/skillzkit",
  "version": "0.1.0",
  "description": "AgentX skillzkit — commands, skills, and workflows for Claude Code. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "skillzkit": "./bin/skillzkit.mjs"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "catalog.json",
    ".claude/commands",
    ".claude/skills",
    "README.md"
  ],
  "scripts": {
    "catalog": "tsx scripts/generate-catalog.ts",
    "build": "npm run catalog && tsup && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declaration --outDir dist",
    "build:lambda": "npm run catalog && tsx scripts/build-lambda.ts",
    "test": "npm run catalog && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run catalog && vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "cli": "bun src/cli.ts"
  },
  "dependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/skillzkit-types": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "bun": "^1.4.2",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "platform/skillzkit/skillzkit"
  },
  "license": "UNLICENSED"
}
