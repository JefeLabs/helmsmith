{
  "name": "@helmsmith/gittyup",
  "version": "0.1.0",
  "description": "Multi-repo orchestration CLI with interactive conflict resolution. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "gittyup": "./bin/gittyup.mjs"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin",
    "dist",
    "branding.yaml",
    "gittyup.example.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "multi-repo",
    "cherry-pick",
    "merge",
    "conflict-resolution",
    "cli"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "dependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@inquirer/ansi": "^2.0.8",
    "@inquirer/core": "^11.2.1",
    "@inquirer/figures": "^2.0.9",
    "@inquirer/prompts": "^8.7.1",
    "bun": "^1.4.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "js-yaml": "^4.3.2",
    "octokit": "^4.1.4",
    "ora": "^8.2.0",
    "simple-git": "^3.36.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/gittyup"
  },
  "license": "MIT"
}
