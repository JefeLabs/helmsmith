{
  "name": "@helmsmith/gittyup",
  "version": "0.1.0",
  "description": "Multi-repo orchestration CLI with interactive conflict resolution. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "gittyup": "./bin/gittyup.mjs"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin",
    "bunfig.toml",
    "dist",
    "branding.yaml",
    "gittyup.example.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "multi-repo",
    "cherry-pick",
    "merge",
    "conflict-resolution",
    "cli"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "dependencies": {
    "@inquirer/ansi": "^2.0.9",
    "@inquirer/core": "^12.0.5",
    "@inquirer/figures": "^2.0.9",
    "@inquirer/prompts": "^8.7.4",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "bun": "^1.4.4",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "js-yaml": "^5.5.0",
    "octokit": "^5.0.5",
    "ora": "^9.4.1",
    "react": "^19.2.9",
    "simple-git": "^3.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/gittyup"
  },
  "license": "MIT"
}
