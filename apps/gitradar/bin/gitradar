#!/bin/sh
# Launcher for the globally-linked `gitradar` command.
#
# gitradar's bundle (dist/cli.js) requires the Bun runtime, which ships as a
# package dependency rather than a global install. This wrapper resolves its
# own real location (the global bin entry is a symlink) and runs the bundle
# with the vendored Bun, so `gitradar` works anywhere without a global Bun.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
dir="$(cd "$(dirname "$self")/.." && pwd)"
# --no-env-file / --config: Bun would otherwise auto-load `.env` and `bunfig.toml`
# (including `preload` scripts) from the *current directory*, which for gitradar is
# routinely a cloned repo — i.e. code execution from whatever repo the user is in.
# The package ships its own empty bunfig.toml so Bun never looks in the cwd.
exec "$dir/node_modules/.bin/bun" --no-env-file --config="$dir/bunfig.toml" "$dir/dist/cli.js" "$@"
