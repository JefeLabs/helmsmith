{
  "name": "@helmsmith/gitradar",
  "version": "0.1.0",
  "description": "Terminal-based TUI analytics tool for git contribution data. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "gitradar": "bin/gitradar"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run && bun run test:bun",
    "test:bun": "bun test src/__tests__/sqlite-store.test.ts src/__tests__/functional.test.ts && bun test src/__tests__/sqlite-active-days.test.ts && bun test src/__tests__/sqlite-scorecard.test.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/gitradar"
  },
  "license": "UNLICENSED",
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@inquirer/prompts": "^8.7.1",
    "bun": "^1.4.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "js-yaml": "^4.3.2",
    "octokit": "^5.0.5",
    "ora": "^8.2.0",
    "p-limit": "^7.3.2",
    "simple-git": "^3.36.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
