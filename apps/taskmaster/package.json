{
  "name": "@helmsmith/taskmaster",
  "version": "0.1.0",
  "description": "CLI-based project task generator with complexity scoring and auto-decomposition. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "taskmaster": "./bin/taskmaster.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/",
    "bin/",
    "src/templates/",
    "src/context/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions"
  },
  "keywords": [
    "cli",
    "task",
    "project",
    "complexity",
    "scoring"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@helmsmith/agent-auth": "workspace:*",
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@inquirer/prompts": "^8.7.1",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "bun": "^1.4.2",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.4.1",
    "marked": "^17.0.6",
    "marked-terminal": "^7.3.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/taskmaster"
  }
}
