{
  "name": "@helmsmith/timetracker",
  "version": "0.1.0",
  "description": "Admin-only Discord bot that tracks per-user daily activity (start/end of day, presence, CI submissions, channel engagement) with a TUI for daily/weekly summaries. Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "timetracker": "./bin/timetracker.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions"
  },
  "dependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@inquirer/prompts": "^8.7.1",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "commander": "^15.0.0",
    "discord.js": "^14.27.0",
    "react": "^19.2.8",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/timetracker"
  },
  "license": "UNLICENSED"
}
