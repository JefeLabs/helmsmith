{
  "name": "@helmsmith/mech-pencil",
  "version": "0.0.1",
  "description": "mech-pencil — generates Pencil .pen design systems and base mockups from framework adapters (HeroUI v3). Part of the agentx-toolbox monorepo.",
  "type": "module",
  "bin": {
    "mech-pencil": "./bin/mech-pencil.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src/frameworks/heroui/library",
    "skill",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && bun build ./src/cli.ts --outdir ./dist --target bun --format esm --packages external && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun run src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "pencil",
    "design-system",
    "heroui",
    "atomic-design"
  ],
  "dependencies": {
    "@helmsmith/cli-kit": "workspace:*",
    "@helmsmith/tui-view-components": "workspace:*",
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "bun": "^1.4.2",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruz165/agentx-toolbox.git",
    "directory": "apps/mech-pencil"
  },
  "license": "UNLICENSED"
}
